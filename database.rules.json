{
  "rules": {
    ".read": false,
    ".write": false,

    "accounts": {
      ".read": true,
      "$account": {
        ".read": true,

        "accountData": {
          ".write": true,
          "passwordHash": {
            ".validate": "!data.exists() || data.val() === '' || newData.val() === data.val()"
          }
        },

        "scores": { ".write": true },
        "jars":   { ".write": true },
        "plays":  { ".write": true },
        "stats":  { ".write": true },
        "config": { ".write": true },

        "$other": { ".write": false }
      }
    },

    "events": {
      ".read": true,
      "guests":  { "$id": { ".write": true, ".validate": "!data.exists()" } },
      "signups": { "$id": { ".write": true, ".validate": "!data.exists()" } },
      "logins":  { "$id": { ".write": true, ".validate": "!data.exists()" } }
    },

    "stats": {
      ".read": true,
      "guest_plays_total": { ".write": true },
      "signups_total":     { ".write": true },
      "logins_total":      { ".write": true }
    }
  }
}
